<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant override: allow cleartext traffic unconditionally so the
  local model server always works while testing, regardless of how a given
  device's WebView matches domain rules. Release builds use the stricter,
  loopback-only config at src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
